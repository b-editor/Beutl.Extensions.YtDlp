<Project Sdk="Beutl.Extensibility.Sdk/2.0.0-preview.9">

    <PropertyGroup>
        <PackageId>Beutl.Extensions.YtDlp</PackageId>
        <Title>yt-dlp Downloader</Title>
        <Description>yt-dlp で動画・音声を検索・ダウンロードしてタイムラインに追加します</Description>
        <!-- Beutl shows the release notes as the long description of an installed package. -->
        <PackageReleaseNotes>YouTube / SoundCloud の検索、URL からの取得、形式を選んだダウンロード、タイムラインへの自動追加、ダウンロード履歴、yt-dlp の自動インストールと更新に対応しています。1.0.1 では、Windows と Linux でダウンロードしたファイルがタイムラインに追加されない問題を修正しました。UI は日本語のみです。</PackageReleaseNotes>
        <!-- Semicolon-separated: NuGet writes them space-separated, which is how Beutl splits tags. -->
        <PackageTags>video;audio;download;youtube;soundcloud;yt-dlp</PackageTags>
        <Version>1.0.1</Version>
        <AssemblyVersion>1.0.1.0</AssemblyVersion>
        <Authors>Yuto Terada</Authors>
        <Copyright>Copyright (c) 2026 Yuto Terada</Copyright>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/b-editor/Beutl.Extensions.YtDlp</PackageProjectUrl>
        <RepositoryUrl>https://github.com/b-editor/Beutl.Extensions.YtDlp</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <BeutlAutoReferenceNodeGraph>false</BeutlAutoReferenceNodeGraph>
        <!-- Beutl 2.0 is still in preview, so a stable release necessarily depends on preview packages. -->
        <NoWarn>$(NoWarn);NU5104</NoWarn>
    </PropertyGroup>

    <!--
        Keep local build paths out of the published assembly: source paths are mapped to /_/, and an
        embedded PDB leaves only its file name in the PE (a separate PDB would record its obj path).
        The embedded PDB also gives line numbers in users' error reports.
    -->
    <PropertyGroup Condition="'$(Configuration)'=='Release'">
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
        <DebugType>embedded</DebugType>
    </PropertyGroup>

    <ItemGroup Condition="'$(Configuration)'=='Debug'">
        <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Beutl.Extensions.YtDlp.Tests" />
    </ItemGroup>

</Project>
